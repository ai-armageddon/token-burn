{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Burn",
  "version": "1.0.0",
  "identifier": "app.tokenburn.deck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "deck",
        "title": "Token Burn — Deck",
        "width": 428,
        "height": 241,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Track AI subscription allowances",
    "longDescription": "Token Burn keeps Claude, Codex, OpenCode Go and Grok allowances visible in a small Deck. Readings come from the CodexBar CLI.",
    "copyright": "See ThirdPartyNotices.txt for provider marks",
    "resources": { "../../Resources/ThirdPartyNotices.txt": "ThirdPartyNotices.txt" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": [] } }
  }
}
